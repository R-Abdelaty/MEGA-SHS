# Backend-only iHQ LiteLLM configuration. Never send the key to the browser.
LITELLM_API_KEY=replace-with-your-ihq-litellm-key
LITELLM_API_BASE=https://litellm.i-hq.tech/v1
LITELLM_MODEL=anthropic/claude-haiku-4-5

# Shared UI-to-backend credential sent in the X-API-Key request header.
SCHEDULER_UI_API_KEY=replace-with-a-long-random-value

# Comma-separated UI origins permitted by CORS.
SCHEDULER_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Sunday that begins academic week 1 in the recurring source workbooks.
SCHEDULE_SEMESTER_START_DATE=2026-07-05

# Optional in-process retention bound and explicit QA-only agent mode.
MEGA_SHS_MAX_STORED_RUNS=200
# MEGA_SHS_AGENT_MODE=deterministic
